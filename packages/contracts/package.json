{
  "name": "@forj/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./abi": {
      "types": "./src/abi.ts",
      "default": "./dist/abi.js"
    },
    "./addresses": {
      "types": "./src/addresses.ts",
      "default": "./dist/addresses.js"
    }
  },
  "files": ["dist", "src", "contracts"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "compile": "hardhat compile",
    "abi:v3": "hardhat compile && node scripts/export-abi-v3.cjs",
    "test": "hardhat test",
    "preflight:sepolia": "hardhat run scripts/preflight.ts --network baseSepolia",
    "deploy:sepolia": "hardhat run scripts/deploy-forj.ts --network baseSepolia",
    "deploy:base": "hardhat run scripts/deploy-forj.ts --network base",
    "deploy:legacy-v1:sepolia": "hardhat run scripts/deploy.ts --network baseSepolia",
    "deploy:v3:sepolia": "hardhat run scripts/deploy-v3.ts --network baseSepolia",
    "check:v3": "hardhat compile && hardhat test && node scripts/export-abi-v3.cjs",
    "transfer-ownership:sepolia": "hardhat run scripts/transfer-ownership.ts --network baseSepolia",
    "transfer-ownership:base": "hardhat run scripts/transfer-ownership.ts --network base",
    "verify:sepolia": "hardhat verify --network baseSepolia",
    "node:local": "hardhat node",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "clean": "rm -rf dist artifacts cache typechain-types .turbo node_modules"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-verify": "^2.0.13",
    "@nomicfoundation/hardhat-viem": "^2.1.3",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.5",
    "@forj/tsconfig": "workspace:*",
    "chai": "^4.5.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "hardhat": "^2.22.18",
    "mocha": "^10.8.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "viem": "^2.22.9"
  }
}
