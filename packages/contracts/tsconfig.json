{
  "extends": "@forj/tsconfig/base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "outDir": "./dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "mocha", "chai"]
  },
  "include": ["./scripts", "./test", "./src", "./hardhat.config.ts"],
  "exclude": ["node_modules", "dist", "artifacts", "cache", "typechain-types"]
}
