# ============================================
# Forj — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# For local development, set SKIP_ENV_VALIDATION=true
# until you have all required API keys.

# ── App ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Forj

# Skip env validation for local dev (set to false in production)
SKIP_ENV_VALIDATION=true

# ── Database (Neon PostgreSQL) ───────────────
# Get from: https://console.neon.tech → Create project → Connection string
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Privy Auth ───────────────────────────────
# Get from: https://dashboard.privy.io → Create app
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret
# Svix signing secret for /api/webhooks/privy (Privy dashboard → Webhooks).
# Server-only. Without it the webhook route rejects every request.
PRIVY_WEBHOOK_SECRET=

# ── Blockchain — Base Network ────────────────
# Get from: https://dashboard.alchemy.com (free tier) or use public RPCs
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_CHAIN_ID=84532
# REQUIRED. 84532 = Base Sepolia, 8453 = Base mainnet. Production builds refuse
# to start without a valid value; there is no fallback between networks.

# Server-side RPC used to verify receipts and index escrow events. Use a keyed
# provider in production; the public endpoints are rate-limited and lag.
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=
# Blocks the escrow indexer stays behind head (reorg margin). Default 3.
ESCROW_CONFIRMATIONS=3

# After deploying contracts (Phase 3):
NEXT_PUBLIC_ESCROW_CONTRACT_ADDRESS=
NEXT_PUBLIC_REPUTATION_CONTRACT_ADDRESS=

# USDC on Base Mainnet (don't change unless on testnet)
NEXT_PUBLIC_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# ── Transak (Fiat On-ramp) ───────────────────
# Get from: https://staging.transak.com (dev) / https://transak.com (prod)
NEXT_PUBLIC_TRANSAK_API_KEY=
NEXT_PUBLIC_TRANSAK_ENV=STAGING

# ── Resend (Email) ───────────────────────────
# Get from: https://resend.com → API Keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@your-verified-domain.com

# ── UploadThing (File Upload) ────────────────
# Get from: https://uploadthing.com → Create app → Settings → API Keys → Token
UPLOADTHING_TOKEN=
# Legacy v6 fields — leave empty if you set the v7 token above.
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# ── Pinata (IPFS) ───────────────────────────
# Get from: https://pinata.cloud → API Keys
PINATA_API_KEY=
PINATA_SECRET_KEY=
NEXT_PUBLIC_PINATA_GATEWAY=

# ── Upstash Redis (Cache & Rate Limiting) ────
# Get from: https://console.upstash.com → Create Redis database
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Inngest (Background Jobs) ───────────────
# Production: get from https://inngest.com → Create app, set both
# EVENT_KEY (for `inngest.send()`) and SIGNING_KEY (for the
# `/api/inngest` webhook signature check).
# Local dev: leave both empty and set `INNGEST_DEV=1` instead — the
# SDK runs in offline mode and uses the local CLI when available
# (`pnpm dlx inngest-cli@latest dev`).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=

# ── Sentry (Error Tracking) ─────────────────
# Get from: https://sentry.io → Create project (Next.js)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ── Contract Deployment ──────────────────────
# Used ONLY when running `pnpm --filter @forj/contracts deploy:*`.
# DO NOT COMMIT with a real private key. Use a dedicated burner wallet
# funded with Sepolia ETH from a faucet.
DEPLOYER_PRIVATE_KEY=

# Address of the multisig (Safe) that governs the deployed escrow
# contracts. After deployment + ownership handoff, this address is
# the `owner()` on every Ownable2Step Forj contract — it controls
# pause/unpause, dispute resolution, fee bps, fee recipient, and the
# auto-release window. Used by scripts/transfer-ownership.ts as the
# target of transferOwnership(); the multisig signers then call
# acceptOwnership() from the Safe to finalise the handoff.
NEXT_PUBLIC_MULTISIG_ADDRESS=

# Wallet address that receives platform fees on every release. Must be
# set at deploy time — baked into the ForjEscrow constructor.
# For prod use a multisig (Safe), not an EOA. Typically same as
# NEXT_PUBLIC_MULTISIG_ADDRESS so treasury and governance share the
# same signer set.
PLATFORM_FEE_RECIPIENT=

# Basescan API key — same key works for mainnet + sepolia.
# https://basescan.org/myapikey
BASESCAN_API_KEY=

# ── Admin / Arbiter ──────────────────────────
# Comma-separated DB user UUIDs allowed to access /admin/disputes.
# Empty / unset = nobody is admin (fail-closed).
# Get the UUID by signing up on the running app, then querying:
#   select id from users where username = '<your-username>';
ADMIN_USER_IDS=

# Optional: hostname that serves the admin surface (e.g.
# `admin.forj.app`). When set, /admin/* is reachable ONLY on this
# host — visits to /admin/* on any other host get a not-found page.
# Leave unset for local dev + demo deploys without a custom admin
# subdomain. Real auth is still the `ADMIN_USER_IDS` + `adminProcedure`
# gate; this is defense-in-depth that removes admin chrome from the
# public domain.
ADMIN_HOSTNAME=
